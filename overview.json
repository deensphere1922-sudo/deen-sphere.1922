    "firestore.rules": [
      "rules_version = '2';",
      "service cloud.firestore {",
      "match /databases/{database}/documents {",
      "function owner(uid) { return request.auth != null && request.auth.uid == uid; }",
      "match /users/{uid}/data/{key} { allow read, delete: if owner(uid); allow create, update: if owner(uid) && (key != \"settings\" || request.resource.data.key == key); }",
      "match /users/{uid}/push_subscriptions/{id} { allow read, delete: if owner(uid); allow create, update: if owner(uid) && request.resource.data.user_id == uid; }",
      "}",
      "}",
